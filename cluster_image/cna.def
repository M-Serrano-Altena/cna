Bootstrap: docker
From: nvidia/cuda:11.7.1-cudnn8-devel-ubuntu22.04

%labels
    Author      Marc Serrano Altena
    Description Cooperative Network Architecture (CNA) container
    CUDA        11.7
    Python      3.10

%environment
    export PATH=/opt/miniforge3/bin:$PATH
    export PYTHONNOUSERSITE=True
    export TOKENIZERS_PARALLELISM=false

%post
    # ------------------------------------------------------------------ #
    #  System packages
    # ------------------------------------------------------------------ #
    apt-get update && apt-get install -y --no-install-recommends \
        wget \
        curl \
        git \
        libgl1 \
        libglib2.0-0 \
        && apt-get clean && rm -rf /var/lib/apt/lists/*

    # ------------------------------------------------------------------ #
    #  Miniforge3
    # ------------------------------------------------------------------ #
    cd /tmp
    wget -q "https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh" \
        -O Miniforge3.sh
    bash Miniforge3.sh -b -p /opt/miniforge3
    rm Miniforge3.sh
    export PATH=/opt/miniforge3/bin:$PATH

    # Install Python 3.10 via mamba (just Python, no PyTorch)
    mamba install -y python=3.10
    mamba clean -afy

    # ------------------------------------------------------------------ #
    #  All pip packages in one call so the resolver sees all constraints
    #  simultaneously and cannot upgrade torch above 1.13.1
    # ------------------------------------------------------------------ #
    pip install --no-cache-dir \
        torch==1.13.1+cu117 \
        torchvision==0.14.1+cu117 \
        torchaudio==0.13.1+cu117 \
        "setuptools<81" \
        "wandb~=0.16.1" \
        "tqdm~=4.66.1" \
        "lightning~=2.1.3" \
        "matplotlib~=3.8.2" \
        "deepdiff~=6.7.1" \
        "opencv-python~=4.9.0.80" \
        "pandas~=2.1.4" \
        "paramiko==4.0.0" \
        "scikit-image" \
        --extra-index-url https://download.pytorch.org/whl/cu117

    # Verify — build fails here if torch got overwritten
    python -c "
import torch, torchvision, torchaudio
assert torch.__version__ == '1.13.1+cu117', f'Wrong torch: {torch.__version__}'
assert torchvision.__version__ == '0.14.1+cu117', f'Wrong torchvision: {torchvision.__version__}'
print('Version check passed:', torch.__version__, torchvision.__version__, torchaudio.__version__)
"

%runscript
    exec python "$@"

%help
    Build:
        sudo apptainer build cna.sif cna.def

    Transfer to Snellius:
        rsync -avP cna.sif <username>@snellius.surf.nl:/path/to/destination/

    Run training:
        apptainer exec --nv cna.sif python main_training.py net-fragments \
            --wandb --plot --store <store_path>